# Leave unset for automatic, persistent local PGlite.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/oneonly
# Set only when running a local production build with PGlite.
# ALLOW_PGLITE=true
APP_URL=http://localhost:3000
# X developer app: OAuth 2.0, Web App, callback below, users.read + tweet.read.
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X callback: http://localhost:3000/api/auth/x/callback

# Trading app (separate from APP_URL, which belongs to early-access X OAuth).
LAUNCHPAD_URL=http://localhost:3000
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Set to app in the app Vercel project to serve /app at the hostname root.
# ONEONLY_SURFACE=app
# Staging deploys: explicit devnet, isolated DATABASE_URL, no MAINNET_DATABASE_URL.
# ONEONLY_ENVIRONMENT=staging
# APP_URL=https://staging.oneonly.lol
# LAUNCHPAD_URL=https://staging.oneonly.lol
# X OAuth uses this host directly; register its /api/auth/x/callback in X.
# Use separate staging X_LINK_SECRET and CRON_SECRET.
# Addresses created by the test-only bootstrap script. No private keys belong here.
# DBC_CONFIG_SOL=
# DBC_CONFIG_USDC=
# Mainnet-only JUP and MET: create owner-signed configs at /app/setup,
# verify the confirmed accounts, then install their public addresses here.
# DBC_CONFIG_JUP=
# DBC_CONFIG_MET=
# Random server-only secret for the activity cron.
# CRON_SECRET=

# Additional quote assets: operator-controlled JSON; see docs/launchpad.md.
# ONEONLY_QUOTE_ASSETS=[]
# JUPITER_API_KEY=
# Enable verified mainnet stock configurations after release checks.
# ONEONLY_STOCKS_ENABLED=false
# Read-only mainnet RPC for reference-price freshness, never for transactions.
# MAINNET_PRICE_RPC_URL=https://api.mainnet-beta.solana.com

# Mainnet deployment: never reuse devnet configs or its test-only wallet.
# SOLANA_NETWORK=mainnet-beta
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# MAINNET_DATABASE_URL=postgres://.../oneonly_mainnet
# ONEONLY_FEE_WALLET=your_public_platform_wallet
# Set mainnet DBC_CONFIG_SOL and DBC_CONFIG_USDC after owner-signed setup.
# The five verified xStocks are catalogued automatically on mainnet; their
# scaled-balance integration is still disabled pending implementation/testing.
